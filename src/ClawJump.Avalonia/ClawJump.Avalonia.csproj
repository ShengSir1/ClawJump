<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<AssemblyName>ClawJump</AssemblyName>
		<RootNamespace>ClawJump.Avalonia</RootNamespace>
		<ApplicationIcon>Assets\claw.ico</ApplicationIcon>

		<Version>0.2.6</Version>
		<FileVersion>0.2.6.0</FileVersion>
		<AssemblyVersion>0.2.6.0</AssemblyVersion>
		<Authors>ShengSir1</Authors>
		<Company>ShengSir1</Company>
		<Product>Claw Jump</Product>
		<Description>Desktop notifier for Claude Code</Description>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.3" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

</Project>